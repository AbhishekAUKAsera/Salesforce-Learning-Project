    <description>Demo: multi-level menu using Radio Button choice components with conditional visibility.</description>
    <interviewLabel>Menu Demo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Menu Demo - Radio Choice Components</label>
    <processType>Flow</processType>

    <screens>
        <name>Main_Menu</name>
        <label>Main Menu</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <allowBack>false</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Route_Module</targetReference></connector>
        <fields>
            <name>Header_Main</name>
            <fieldText>Salesforce App Launcher - Menu Demo</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>mainMenuSelection</name>
            <choiceReferences>Choice_Sales</choiceReferences>
            <choiceReferences>Choice_Service</choiceReferences>
            <choiceReferences>Choice_Marketing</choiceReferences>
            <choiceReferences>Choice_Analytics</choiceReferences>
            <choiceReferences>Choice_Settings</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Choose a Module</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
            <helpText>Pick one of the five core modules. Each has its own sub-menu with specific features.</helpText>
        </fields>
        <fields>
            <name>Info_Sales</name>
            <fieldText>Leads, Opportunities, Accounts, Forecasting, Quotes</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>mainMenuSelection</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue><stringValue>Sales</stringValue></rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Info_Service</name>
            <fieldText>Cases, Knowledge, Console, Chat, SLAs</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>mainMenuSelection</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue><stringValue>Service</stringValue></rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Info_Marketing</name>
            <fieldText>Campaigns, Journeys, Email, Social, Advertising</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>mainMenuSelection</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue><stringValue>Marketing</stringValue></rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Info_Analytics</name>
            <fieldText>Dashboards, Reports, Einstein, Tableau CRM</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>mainMenuSelection</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue><stringValue>Analytics</stringValue></rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Info_Settings</name>
            <fieldText>Users, Profiles, Security, Data, Automation</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>mainMenuSelection</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue><stringValue>Settings</stringValue></rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

