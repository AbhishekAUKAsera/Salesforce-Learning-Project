<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description>Three-step screen flow to onboard a new customer.</description>
    <interviewLabel>New Customer Onboarding {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Customer Onboarding</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <startElementReference>Basic_Details</startElementReference>
    <status>Active</status>

    <screens>
        <name>Basic_Details</name>
        <label>Basic Details</label>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Address</targetReference>
        </connector>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
        <fields>
            <name>firstName</name>
            <dataType>String</dataType>
            <fieldText>First Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <!--<storeOutputAutomatically>true</storeOutputAutomatically>-->
        </fields>
        <fields>
            <name>lastName</name>
            <dataType>String</dataType>
            <fieldText>Last Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <!--<storeOutputAutomatically>true</storeOutputAutomatically>-->
        </fields>
        <fields>
            <name>phone</name>
            <dataType>String</dataType>
            <fieldText>Phone</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <!--<storeOutputAutomatically>true</storeOutputAutomatically>-->
        </fields>
        <fields>
            <name>email</name>
            <dataType>String</dataType>
            <fieldText>Email</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <!--<storeOutputAutomatically>true</storeOutputAutomatically>-->
        </fields>
    </screens>

    <screens>
        <name>Address</name>
        <label>Address</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Review_and_Submit</targetReference>
        </connector>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
        <fields>
            <name>billingStreet</name>
            <dataType>String</dataType>
            <fieldText>Billing Street</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <!--<storeOutputAutomatically>true</storeOutputAutomatically>-->
        </fields>
        <fields>
            <name>billingCity</name>
            <dataType>String</dataType>
            <fieldText>City</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <!--<storeOutputAutomatically>true</storeOutputAutomatically>-->
        </fields>
        <fields>
            <name>billingState</name>
            <dataType>String</dataType>
            <fieldText>State</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <!--<storeOutputAutomatically>true</storeOutputAutomatically>-->
        </fields>
        <fields>
            <name>billingPostalCode</name>
            <dataType>String</dataType>
            <fieldText>Postal Code</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
           <!--<storeOutputAutomatically>true</storeOutputAutomatically>-->
        </fields>
    </screens>

    <screens>
        <name>Review_and_Submit</name>
        <label>Review and Submit</label>
        <locationX>50</locationX>
        <locationY>400</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
        <fields>
            <name>Review_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Name:&lt;/b&gt; {!firstName} {!lastName}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Phone:&lt;/b&gt; {!phone}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Email:&lt;/b&gt; {!email}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Address:&lt;/b&gt; {!billingStreet}, {!billingCity}, {!billingState} {!billingPostalCode}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
    </screens>
</Flow>