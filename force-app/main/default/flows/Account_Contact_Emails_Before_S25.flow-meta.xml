<?xml version="1.0" encoding="UTF-8"?>
<!--
  BEFORE Summer '25: to get an Account with its related Contacts and Opportunities,
  the flow needs a separate Get Records element for each child object.
  Each lookup is one more element to build, maintain, and debug.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <label>Before Summer 25 - Get Account and Related Records</label>
    <description>Pre-Summer '25 approach: one Get Records element for the Account, plus a separate Get Records element for each related object.</description>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>

    <variables>
        <name>varAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <!-- Lookup 1 of 3: the Account -->
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>Get_Related_Contacts</targetReference>
        </connector>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varAccountId</elementReference>
            </value>
        </filters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <!-- Lookup 2 of 3: Contacts related to the Account -->
    <recordLookups>
        <name>Get_Related_Contacts</name>
        <label>Get Related Contacts</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <connector>
            <targetReference>Get_Related_Opportunities</targetReference>
        </connector>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Account.Id</elementReference>
            </value>
        </filters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <!-- Lookup 3 of 3: Opportunities related to the Account -->
    <recordLookups>
        <name>Get_Related_Opportunities</name>
        <label>Get Related Opportunities</label>
        <locationX>176</locationX>
        <locationY>374</locationY>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Account.Id</elementReference>
            </value>
        </filters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <startElementReference>Get_Account</startElementReference>
    <status>Draft</status>
</Flow>