<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Builds a semicolon-separated list of email addresses for all Contacts of an Account.</description>
    <environments>Default</environments>
    <interviewLabel>Account Contact Emails - S25 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Contact Emails - S25</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Draft</status>

    <!-- Start -->
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Account_Contacts</targetReference>
        </connector>
    </start>

    <!-- Input: Account Id -->
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <!-- Output: semicolon-separated email list -->
    <variables>
        <name>emailList</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>

    <!-- Formula: appends the current Contact's email to the list -->
    <formulas>
        <name>appendEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!emailList}), {!Loop_Contacts.Email}, {!emailList} &amp; ";" &amp; {!Loop_Contacts.Email})</expression>
    </formulas>

    <!-- Get all Contacts whose AccountId = the input record -->
    <recordLookups>
        <name>Get_Account_Contacts</name>
        <label>Get Account Contacts</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Contacts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <queriedFields>Id</queriedFields>
        <queriedFields>Email</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
    </recordLookups>

    <!-- Loop over the Contacts -->
    <loops>
        <name>Loop_Contacts</name>
        <label>Loop Contacts</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <collectionReference>Get_Account_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Has_Email</targetReference>
        </nextValueConnector>
    </loops>

    <!-- Skip Contacts with a blank Email -->
    <decisions>
        <name>Has_Email</name>
        <label>Has Email?</label>
        <locationX>176</locationX>
        <locationY>374</locationY>
        <defaultConnector>
            <targetReference>Loop_Contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Email_Not_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Contacts.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_To_List</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>

    <!-- Store the appended list, then go back to the loop -->
    <assignments>
        <name>Add_To_List</name>
        <label>Add to List</label>
        <locationX>44</locationX>
        <locationY>494</locationY>
        <assignmentItems>
            <assignToReference>emailList</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>appendEmail</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contacts</targetReference>
        </connector>
    </assignments>

    <status>Draft</status>
</Flow>